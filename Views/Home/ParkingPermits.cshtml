@model List<ParkingProjectClient.Models.ParkingPermits>

@{
    ViewData["Title"] = "Parking Permits";
    string searchQuery = Context.Request.Query["searchQuery"].ToString() ?? "";
}

<div class="text-center">
    <h1 class="display-4">Parking Permits</h1>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchQuery" class="form-control" placeholder="Search by License Plate" value="@searchQuery"/>
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="@Url.Action("ParkingPermits", "Home")" class="btn btn-secondary">Clear</a>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Effective Date</th>
                <th>Expiration Date</th>
                <th>License Plate</th>
                <th>Parking Area Name</th>
                <th>Inactive</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var permit in Model)
            {
                <tr>
                    <td colspan="7">
                        <a href="@Url.Action("ParkingPermitDetails", "Home", new { id = permit.Id })" >
                            <div class="row">
                                <div class="col">@permit.EffectiveDate.ToShortDateString()</div>
                                <div class="col">@permit.ExpirationDate.ToShortDateString()</div>
                                <div class="col">@permit.LicensePlate</div>
                                <div class="col">@permit.ParkingAreaName</div>
                                <div class="col">@permit.Inactive</div>
                            </div>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No parking areas available.</p>
}

<div class="mb-3 text-right">
    <a href="@Url.Action("CreateParkingPermit", "Home")" class="btn btn-primary">
        Create New Parking Permit
    </a>
</div>

