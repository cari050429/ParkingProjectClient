@model List<ParkingProjectClient.Models.ParkingPermits>

@{
    ViewData["Title"] = "Parking Permits";
    string parkingAreaName = Context.Request.Query["parkingAreaName"].ToString() ?? "";
    string licensePlate = Context.Request.Query["licensePlate"].ToString() ?? "";
    string inactiveFilter = Context.Request.Query["inactiveFilter"].ToString() ?? "";
    string effectiveDateFilter = Context.Request.Query["effectiveDateFilter"].ToString() ?? "";
    string expirationDateFilter = Context.Request.Query["expirationDateFilter"].ToString() ?? "";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Parking Permits</h1>
    </div>

    <form method="get" class="mb-4">
        <div class="row g-3">
            <!-- Search by License Plate -->
            <div class="col-md-3">
                <label for="licensePlate" class="form-label">License Plate</label>
                <input 
                    type="text" 
                    name="licensePlate" 
                    id="licensePlate" 
                    class="form-control" 
                    placeholder="Enter license plate" 
                    value="@licensePlate" />
            </div>

            <div class="col-md-3">
                <label for="parkingAreaName" class="form-label">Parking Area Name</label>
                <input 
                    type="text" 
                    name="parkingAreaName" 
                    id="parkingAreaName" 
                    class="form-control" 
                    placeholder="Enter parking area name" 
                    value="@parkingAreaName" />
            </div>

           <div class="col-md-2">
    <label for="inactiveFilter" class="form-label">Status</label>
            <select 
                name="inactiveFilter" 
                id="inactiveFilter" 
                class="form-select">
                <option value="">All</option>
                @{
                    var selectedInactive = ViewBag.InactiveFilter == "true" ? "selected" : null;
                    var selectedActive = ViewBag.InactiveFilter == "false" ? "selected" : null;
                }
                <option value="true" selected="@selectedInactive">Inactive</option>
                <option value="false" selected="@selectedActive">Active</option>
            </select>
        </div>

            <!-- Filter by Effective Date -->
            <div class="col-md-2">
                <label for="effectiveDateFilter" class="form-label">Effective Date</label>
                <input 
                    type="date" 
                    name="effectiveDateFilter" 
                    id="effectiveDateFilter" 
                    class="form-control" 
                    value="@effectiveDateFilter" />
            </div>

            <!-- Filter by Expiration Date -->
            <div class="col-md-2">
                <label for="expirationDateFilter" class="form-label">Expiration Date</label>
                <input 
                    type="date" 
                    name="expirationDateFilter" 
                    id="expirationDateFilter" 
                    class="form-control" 
                    value="@expirationDateFilter" />
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="text-end mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Apply Filters
            </button>
            <a href="@Url.Action("ParkingPermits", "Home")" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Clear Filters
            </a>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Effective Date</th>
                    <th>Expiration Date</th>
                    <th>License Plate</th>
                    <th>Parking Area Name</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var permit in Model)
                {
                    <tr>
                        <td>@permit.EffectiveDate.ToShortDateString()</td>
                        <td>@permit.ExpirationDate.ToShortDateString()</td>
                        <td>@permit.LicensePlate</td>
                        <td>@permit.ParkingAreaName</td>
                        <td>
                            @if (permit.Inactive)
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("ParkingPermitDetails", "Home", new { id = permit.Id })" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No parking permits available.
        </div>
    }

    <div class="text-right mt-4">
        <a href="@Url.Action("CreateParkingPermit", "Home")" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create New Parking Permit
        </a>
    </div>
</div>
