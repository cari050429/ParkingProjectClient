@model List<ParkingProjectClient.Models.ParkingPermits>

@{
    ViewData["Title"] = "Parking Permits";
    string searchQuery = Context.Request.Query["searchQuery"].ToString() ?? "";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Parking Permits</h1>
    </div>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input 
                type="text" 
                name="searchQuery" 
                class="form-control" 
                placeholder="Search by License Plate" 
                value="@searchQuery" />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
            <a href="@Url.Action("ParkingPermits", "Home")" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Clear
            </a>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Effective Date</th>
                    <th>Expiration Date</th>
                    <th>License Plate</th>
                    <th>Parking Area Name</th>
                    <th>Inactive</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var permit in Model)
                {
                    <tr>
                        <td>@permit.EffectiveDate.ToShortDateString()</td>
                        <td>@permit.ExpirationDate.ToShortDateString()</td>
                        <td>@permit.LicensePlate</td>
                        <td>@permit.ParkingAreaName</td>
                        <td>
                            @if (permit.Inactive)
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("ParkingPermitDetails", "Home", new { id = permit.Id })" class="btn btn-info btn-sm">
                                <i class="bi bi-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No parking permits available.
        </div>
    }

    <div class="text-right mt-4">
        <a href="@Url.Action("CreateParkingPermit", "Home")" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create New Parking Permit
        </a>
    </div>
</div>
