@model ParkingProjectClient.Models.ParkingPermits

@{
    ViewData["Title"] = "Create Parking Permit";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Create Parking Permit</h1>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <form asp-action="CreateParkingPermit" method="post">
        <div class="mb-3">
            <label asp-for="ParkingAreaId" class="form-label">Parking Area Name</label>
            <select asp-for="ParkingAreaId" 
                    asp-items="ViewBag.ParkingAreas" 
                    class="form-select" 
                    id="parkingAreaSelect">
            </select>
            <span asp-validation-for="ParkingAreaId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EffectiveDate" class="form-label">Effective Date</label>
            <input asp-for="EffectiveDate" class="form-control" type="date" />
            <span asp-validation-for="EffectiveDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ExpirationDate" class="form-label">Expiration Date</label>
            <input asp-for="ExpirationDate" class="form-control" type="date" />
            <span asp-validation-for="ExpirationDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LicensePlate" class="form-label">License Plate</label>
            <input asp-for="LicensePlate" class="form-control" />
            <span asp-validation-for="LicensePlate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Inactive" class="form-label">Mark as Inactive</label>
            <div class="form-check">
                <input asp-for="Inactive" type="checkbox" class="form-check-input" />
                <label class="form-check-label" for="Inactive">Inactive</label>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary me-2">
                <i class="bi bi-check-circle"></i> Create
            </button>
            <a asp-action="ParkingPermits" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>
