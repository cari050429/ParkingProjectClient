@model List<ParkingProjectClient.Models.ParkingAreaTypes>

@{
    ViewData["Title"] = "Parking Area Type";
    string searchQuery = Context.Request.Query["searchQuery"].ToString() ?? "";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Parking Area Type</h1>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <form method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchQuery" class="form-control" placeholder="Search by Parking Type Description" value="@searchQuery" />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
            <a href="@Url.Action("ParkingAreaTypes", "Home")" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Clear
            </a>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Parking Area Type Description</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var parkingareatype in Model)
                {
                    <tr>
                        <td>@parkingareatype.ParkingAreaTypeDescription</td>
                        <td class="text-center">
                            <a href="@Url.Action("UpdateParkingAreaType", "Home", new { id = parkingareatype.Id })" class="btn btn-warning me-2">
                                <i class="bi bi-pencil-square"></i> Update
                            </a>
                            <a href="@Url.Action("DeleteParkingAreaType", "Home", new { id = parkingareatype.Id })" 
                               class="btn btn-danger" 
                               onclick="return confirm('Are you sure you want to delete this parking area type?');">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No parking area types available.
        </div>
    }

    <div class="text-right">
        <a href="@Url.Action("CreateParkingAreaType", "Home")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Parking Area Type
        </a>
    </div>
</div>
