@model List<ParkingProjectClient.Models.ParkingAreaTypes>

    @{
        ViewData["Title"] = "Parking Area Type";
    }
    
    <div class="text-center">
        <h1 class="display-4">Parking Area Type</h1>
    </div>
    
    @if (Model != null && Model.Any())
    {
        <table class="table">
            <thead>
                <tr>

                    <th>Parking Area Type Description</th>
                    <th>Inactive</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var parkingareatype in Model)
                {
                    <tr>
                        <td colspan="7">
                                <div class="row">

                                    <div class="col">@parkingareatype.ParkingAreaTypeDescription</div>                                
                                    <div class="col">@parkingareatype.Inactive</div>
                                </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center">
                            <a href="@Url.Action("UpdateParkingAreaType", "Home", new { id = parkingareatype.Id })" class="btn btn-warning">Update</a>
                            <a href="@Url.Action("DeleteParkingAreaType", "Home", new { id = parkingareatype.Id })" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this parking area type?');">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No parking areas available.</p>
    }
    
    <div class="mb-3 text-right">
        <a href="@Url.Action("CreateParkingAreaType", "Home")" class="btn btn-primary">
            Create New Parking Area Type
        </a>
    </div>