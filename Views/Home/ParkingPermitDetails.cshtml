@model ParkingProjectClient.Models.ParkingPermitDetails

@{
    ViewData["Title"] = "Parking Permit Details";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Parking Permit Details</h1>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null)
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Effective Date</th>
                    <th>Expiration Date</th>
                    <th>Longitude</th>
                    <th>Latitude</th>
                    <th>Date Created</th>
                    <th>Parking Area Type Description</th>
                    <th>License Plate</th>
                    <th>Parking Area Name</th>
                    <th>Inactive</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.EffectiveDate.ToShortDateString()</td>
                    <td>@Model.ExpirationDate.ToShortDateString()</td>
                    <td>@Model.Longitude</td>
                    <td>@Model.Latitude</td>
                    <td>@Model.DateCreated.ToShortDateString()</td>
                    <td>@Model.ParkingAreaTypeDescription</td>
                    <td>@Model.LicensePlate</td>
                    <td>@Model.ParkingAreaName</td>
                    <td>
                        @if (Model.Inactive)
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td colspan="9" class="text-center">
                        <a href="@Url.Action("UpdateParkingPermit", "Home", new { id = Model.Id })" class="btn btn-warning me-2">
                            <i class="bi bi-pencil-square"></i> Update
                        </a>
                        <a href="@Url.Action("DeleteParkingPermit", "Home", new { permitId = Model.Id })" 
                           class="btn btn-danger" 
                           onclick="return confirm('Are you sure you want to delete this parking permit?');">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No parking permit details available.
        </div>
    }
</div>
