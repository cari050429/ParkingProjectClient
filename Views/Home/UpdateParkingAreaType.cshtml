@model ParkingProjectClient.Models.ParkingAreaTypes

@{
    ViewData["Title"] = "Update Parking Area Type";
}

<div class="text-center">
    <h1 class="display-4">Update Parking Area Type</h1>
</div>

<form asp-action="UpdateParkingAreaType" method="post">


    <div class="form-group">
        <label asp-for="ParkingAreaTypeDescription" class="control-label">Parking Area Name</label>
        <input asp-for="ParkingAreaTypeDescription" class="form-control" />
        <span asp-validation-for="ParkingAreaTypeDescription" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="ParkingAreaTypes" class="btn btn-secondary">Cancel</a>
</form>

