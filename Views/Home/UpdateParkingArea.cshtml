@model ParkingProjectClient.Models.ParkingArea

@{
    ViewData["Title"] = "Update Parking Area";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Update Parking Area</h1>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <form asp-action="UpdateParkingArea" method="post">
        <div class="mb-3">
            <label asp-for="ParkingAreaTypeID" class="form-label">Parking Area Type Description</label>
            <select 
                asp-for="ParkingAreaTypeID" 
                class="form-select" 
                id="parkingAreaTypeSelect" 
                asp-items="ViewBag.ParkingAreaTypes">
            </select>
            <span asp-validation-for="ParkingAreaTypeID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Latitude" class="form-label">Latitude</label>
            <input asp-for="Latitude" class="form-control" type="number" step="0.000001" min="-90" max="90" />
            <span asp-validation-for="Latitude" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Longitude" class="form-label">Longitude</label>
            <input asp-for="Longitude" class="form-control" type="number" step="0.000001" min="-180" max="180" />
            <span asp-validation-for="Longitude" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ParkingAreaName" class="form-label">Parking Area Name</label>
            <input asp-for="ParkingAreaName" class="form-control" />
            <span asp-validation-for="ParkingAreaName" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary me-2">
                <i class="bi bi-check-circle"></i> Update
            </button>
            <a asp-action="ParkingAreas" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>
