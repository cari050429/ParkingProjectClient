@model List<ParkingProjectClient.Models.ParkingArea>

@{
    ViewData["Title"] = "Parking Areas";
}

<div class="text-center">
    <h1 class="display-4">Parking Areas</h1>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Latitude</th>
                <th>Date Created</th>
                <th>Parking Area Type Description</th>
                <th>Longitude</th>
                <th>Parking Area Name</th>
                <th>Inactive</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var parkingarea in Model)
            {
                <tr>
                    <td colspan="7">
                            <div class="row">
                                <div class="col">@parkingarea.Latitude</div>
                                <div class="col">@parkingarea.DateCreated</div>
                                <div class="col">@parkingarea.ParkingAreaTypeDescription</div>                                
                                <div class="col">@parkingarea.Longitude</div>
                                <div class="col">@parkingarea.ParkingAreaName</div>
                                <div class="col">@parkingarea.Inactive</div>
                            </div>
                    </td>
                </tr>
                <tr>
                    <td class="text-center">
                        <a href="@Url.Action("UpdateParkingArea", "Home", new { id = parkingarea.Id })" class="btn btn-warning">Update</a>
                        <a href="@Url.Action("DeleteParkingArea", "Home", new { id = parkingarea.Id })" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this parking area?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No parking areas available.</p>
}

<div class="mb-3 text-right">
    <a href="@Url.Action("CreateParkingArea", "Home")" class="btn btn-primary">
        Create New Parking Area
    </a>
</div>