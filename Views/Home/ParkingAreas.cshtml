@model List<ParkingProjectClient.Models.ParkingArea>

@{
    ViewData["Title"] = "Parking Areas";
    string parkingAreaName = Context.Request.Query["parkingAreaName"].ToString() ?? "";
    string parkingAreaTypeDescription = Context.Request.Query["parkingAreaTypeDescription"].ToString() ?? "";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">Parking Areas</h1>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <form method="get" class="mb-4">
        <div class="row">
            <div class="col-md-3">
                <label for="parkingAreaName" class="form-label">Parking Area Name</label>
                <input type="text" name="parkingAreaName" class="form-control" placeholder="Search by Parking Area Name" value="@parkingAreaName" />
            </div>

             <div class="col-md-3">
                <label for="parkingAreaTypeDescription" class="form-label">Parking Area Type Description</label>
                <input type="text" name="parkingAreaTypeDescription" class="form-control" placeholder="Search by Description" value="@parkingAreaTypeDescription" />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-primary mt-4">
                    <i class="bi bi-search"></i> Search
                </button>
                <a href="@Url.Action("ParkingAreas", "Home")" class="btn btn-secondary mt-4">
                    <i class="bi bi-x-circle"></i> Clear
                </a>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Date Created</th>
                    <th>Parking Area Type Description</th>
                    <th>Longitude</th>
                    <th>Latitude</th>
                    <th>Parking Area Name</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var parkingarea in Model)
                {
                    <tr>
                        <td>@parkingarea.DateCreated</td>
                        <td>@parkingarea.ParkingAreaTypeDescription</td>
                        <td>@parkingarea.Longitude</td>
                        <td>@parkingarea.Latitude</td>
                        <td>@parkingarea.ParkingAreaName</td>
                        <td class="text-center">
                            <a href="@Url.Action("UpdateParkingArea", "Home", new { id = parkingarea.Id })" class="btn btn-warning me-2">
                                <i class="bi bi-pencil-square"></i> Update
                            </a>
                            <a href="@Url.Action("DeleteParkingArea", "Home", new { id = parkingarea.Id })" 
                               class="btn btn-danger" 
                               onclick="return confirm('Are you sure you want to delete this parking area?');">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No parking areas available.
        </div>
    }

    <div class="text-right">
        <a href="@Url.Action("CreateParkingArea", "Home")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Parking Area
        </a>
    </div>
</div>
